+        $this->assertDatabaseHas('timetable_periods', ['period' => 5, 'starts_at' => '12:00', 'ends_at' => '12:40']);
+        $this->assertDatabaseHas('timetable_periods', ['period' => 7, 'starts_at' => '13:20', 'ends_at' => '14:00']);
