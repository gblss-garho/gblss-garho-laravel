                                                                                                                                                                                                                                                                                                                                                                                                                                                 }
-                                                                                                                                                                                                                                                                                                                                                                                                                                                                        $text = 'السلام عليڪم، ' . $s->name . ' اڄ (' . $date . ') اسڪول ۾ غير حاضر ھو. - گورنمينٽ بوائز لوئر سيڪنڊري اسڪول ڳڙھو';
