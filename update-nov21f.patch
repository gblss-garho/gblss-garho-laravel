+        $this->assertStringStartsWith('/uploads/teachers/'.$t->id.'.', $t->photo_url);
+        @unlink(public_path(strtok(ltrim($t->photo_url, '/'), '?')));
+
+        $this->put('/admin/teachers/'.$t->id, $base + ['remove_photo' => 1])->assertSessionHasNoErrors();
