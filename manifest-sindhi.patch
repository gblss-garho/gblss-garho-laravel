diff --git a/app/Console/Commands/SendAbsenceAlerts.php b/app/Console/Commands/SendAbsenceAlerts.php
index 9c9e6aa..dd54000 100644
--- a/app/Console/Commands/SendAbsenceAlerts.php
+++ b/app/Console/Commands/SendAbsenceAlerts.php
@@ -76,8 +76,8 @@ class SendAbsenceAlerts extends Command
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 'to' => $to,
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             'type' => 'template',
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         'template' => [
