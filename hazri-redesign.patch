+/* direction arrows + blink eye (shown for the active liveness challenge) */
+.fs-arrow, .fs-eye { position: absolute; display: none; z-index: 3; color: #FCD34D; pointer-events: none;
+                     filter: drop-shadow(0 0 7px rgba(245,158,11,.95)) drop-shadow(0 2px 6px rgba(0,0,0,.6)); }
+.fs-arrow { top: 50%; width: 19%; margin-top: -10%; }
+.fs-arrow.l { left: 8.5%; } .fs-arrow.r { right: 8.5%; }
+.fs-arrow svg, .fs-eye svg { width: 100%; height: auto; display: block; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
+.fs-eye { left: 50%; bottom: 16%; width: 24%; margin-left: -12%; }
+.fs[data-act=turn_left]  .fs-arrow.l { display: block; animation: fsNudgeL .8s ease-in-out infinite; }
+.fs[data-act=turn_right] .fs-arrow.r { display: block; animation: fsNudgeR .8s ease-in-out infinite; }
+.fs[data-act=blink] .fs-eye { display: block; }
+.fs[data-act=blink] .fs-eye svg { animation: fsBlink 1.1s ease-in-out infinite; transform-origin: 50% 50%; }
+@keyframes fsNudgeL { 0%,100% { transform: translateX(0); opacity: .7; } 50% { transform: translateX(-9px); opacity: 1; } }
+@keyframes fsNudgeR { 0%,100% { transform: translateX(0); opacity: .7; } 50% { transform: translateX(9px); opacity: 1; } }
+@keyframes fsBlink { 0%,60%,100% { transform: scaleY(1); } 78% { transform: scaleY(.12); } }
