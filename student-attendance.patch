+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Student;
+use App\Services\ClassAttendanceReport;
+use Carbon\Carbon;
+use Illuminate\Http\Request;
+
+/** Weekly / monthly student attendance record, for teachers (own classes) and admin (all classes). */
+class ClassAttendanceController extends Controller
+{
+    public function index(Request $request, ClassAttendanceReport $report)
+    {
+        $user = $request->user();
+        $isAdmin = $user->role === 'admin';
+        $teacher = $isAdmin ? null : $user->teacher;
+
+        $classes = $isAdmin
+            ? Student::where('passed_out', false)->distinct()->orderBy('class')->pluck('class')->all()
+            : ($teacher ? array_values($teacher->assigned_classes_list) : []);
+
+        $class = (string) $request->query('class', $classes[0] ?? '');
+        $mode = $request->query('mode') === 'week' ? 'week' : 'month';
+        $q = trim((string) $request->query('q', ''));
+
+        $month = (string) $request->query('month', '');
+        $month = preg_match('/^\d{4}-(0[1-9]|1[0-2])$/', $month) ? $month : Carbon::now()->format('Y-m');
+        $anchor = (string) $request->query('week', '');
+        $anchor = preg_match('/^\d{4}-\d{2}-\d{2}$/', $anchor) ? Carbon::parse($anchor) : Carbon::now();
+
+        if ($mode === 'week') {
+            $from = $anchor->copy()->startOfWeek(Carbon::MONDAY);
+            $to = $from->copy()->addDays(6);
+        } else {
+            $from = Carbon::parse($month.'-01')->startOfMonth();
+            $to = $from->copy()->endOfMonth();
+        }
+
+        $dayDate = (string) $request->query('date', '');
+        $dayDate = preg_match('/^\d{4}-\d{2}-\d{2}$/', $dayDate) ? $dayDate : null;
+        $dayStatus = in_array($request->query('st'), ['present', 'absent', 'leave'], true) ? $request->query('st') : 'all';
+
+        $data = null;
+        if ($class !== '' && in_array($class, $classes, true)) {
+            $data = $report->build($class, $from, $to, $mode, $q, $dayDate, $dayStatus);
+        }
+
+        return view('attendance.class-report', [
+            'isAdmin' => $isAdmin, 'teacher' => $teacher, 'classes' => $classes, 'class' => $class,
+            'mode' => $mode, 'month' => $month, 'from' => $from, 'to' => $to, 'q' => $q,
+            'dayDate' => $dayDate, 'dayStatus' => $dayStatus, 'data' => $data,
+            'base' => $isAdmin ? route('admin.class-attendance', [], false) : route('teacher.class-attendance', [], false),
+            'back' => $isAdmin ? route('admin.dashboard', [], false) : route('teacher.dashboard', [], false),
+            'prev' => $mode === 'week' ? $from->copy()->subWeek()->toDateString() : $from->copy()->subMonth()->format('Y-m'),
+            'next' => $mode === 'week' ? $from->copy()->addWeek()->toDateString() : $from->copy()->addMonth()->format('Y-m'),
+        ]);
+    }
+}
diff --git a/app/Services/ClassAttendanceReport.php b/app/Services/ClassAttendanceReport.php
new file mode 100644
index 0000000..dbe1646
--- /dev/null
+++ b/app/Services/ClassAttendanceReport.php
@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\AttendanceMark;
+use App\Models\AttendanceRecord;
+use App\Models\Student;
+use Carbon\Carbon;
+
+/** Builds per-student attendance for a class over a week or a month. */
+class ClassAttendanceReport
+{
+    public const REGULAR_AT = 85;
+    public const AVERAGE_AT = 70;
+
+    /**
+     * @return array{days: array, students: array, summary: array}
+     */
+    public function build(string $class, Carbon $from, Carbon $to, string $mode, string $q = '', ?string $dayDate = null, ?string $dayStatus = null): array
+    {
+        $records = AttendanceRecord::where('class_name', $class)
+            ->whereDate('date', '>=', $from->toDateString())
+            ->whereDate('date', '<=', $to->toDateString())
+            ->get()
+            ->keyBy(fn ($r) => Carbon::parse($r->date)->toDateString());
+
+        $marks = $records->isEmpty() ? collect() : AttendanceMark::whereIn('attendance_record_id', $records->pluck('id'))
+            ->get(['attendance_record_id', 'student_id', 'status'])
+            ->groupBy('student_id');
+        $dateOfRecord = $records->mapWithKeys(fn ($r, $d) => [$r->id => $d]);
+
+        // Columns: week = every calendar day; month = only days the class had attendance taken.
+        $days = [];
+        if ($mode === 'week') {
+            for ($d = $from->copy(); $d->lte($to); $d->addDay()) {
+                $days[] = ['date' => $d->toDateString(), 'label' => $d->format('D'), 'num' => $d->format('j'), 'taken' => $records->has($d->toDateString())];
+            }
+        } else {
+            foreach ($records->keys()->sort() as $date) {
+                $c = Carbon::parse($date);
+                $days[] = ['date' => $date, 'label' => $c->format('D'), 'num' => $c->format('j'), 'taken' => true];
+            }
+        }
+        $classDays = $records->count();
+
+        $students = Student::where('class', $class)->where('passed_out', false)
+            ->when($q !== '', fn ($x) => $x->where(function ($w) use ($q) {
+                $w->where('name', 'like', "%{$q}%")->orWhere('gr_number', 'like', "%{$q}%")->orWhere('father_name', 'like', "%{$q}%");
+            }))
+            ->orderBy('name')->get();
+
+        $out = [];
+        $sumPct = 0;
+        $withData = 0;
+        foreach ($students as $s) {
+            $byDate = [];
+            foreach ($marks->get($s->id, collect()) as $m) {
+                $d = $dateOfRecord->get($m->attendance_record_id);
+                if ($d) {
+                    $byDate[$d] = $m->status;
+                }
+            }
+            $cells = [];
+            $p = $a = $l = 0;
+            foreach ($days as $day) {
+                $st = null;
+                if ($records->has($day['date'])) {
+                    $raw = $byDate[$day['date']] ?? 'A';
+                    $st = $raw === 'P' ? 'P' : ($raw === 'L' ? 'L' : 'A');
+                    $st === 'P' ? $p++ : ($st === 'L' ? $l++ : $a++);
+                }
+                $cells[] = $st;
+            }
+            $counted = $p + $a;
+            $pct = $counted > 0 ? (int) round($p * 100 / $counted) : null;
+            $level = $pct === null ? 'none' : ($pct >= self::REGULAR_AT ? 'regular' : ($pct >= self::AVERAGE_AT ? 'average' : 'irregular'));
+
+            $dayState = null;
+            if ($dayDate) {
+                $dayState = $records->has($dayDate) ? (($byDate[$dayDate] ?? 'A') === 'P' ? 'P' : (($byDate[$dayDate] ?? 'A') === 'L' ? 'L' : 'A')) : null;
+                if ($dayStatus && $dayStatus !== 'all') {
+                    $want = ['present' => 'P', 'absent' => 'A', 'leave' => 'L'][$dayStatus] ?? null;
+                    if ($want && $dayState !== $want) {
+                        continue;
+                    }
+                }
+            }
+            if ($pct !== null) {
+                $sumPct += $pct;
+                $withData++;
+            }
+            $out[] = ['student' => $s, 'cells' => $cells, 'p' => $p, 'a' => $a, 'l' => $l, 'pct' => $pct, 'level' => $level, 'dayState' => $dayState];
+        }
+
+        return [
+            'days' => $days,
+            'students' => $out,
+            'summary' => [
+                'class_days' => $classDays,
+                'avg' => $withData ? (int) round($sumPct / $withData) : null,
+                'regular' => count(array_filter($out, fn ($r) => $r['level'] === 'regular')),
+                'average' => count(array_filter($out, fn ($r) => $r['level'] === 'average')),
+                'irregular' => count(array_filter($out, fn ($r) => $r['level'] === 'irregular')),
+                'total' => count($out),
+            ],
+        ];
+    }
+}
