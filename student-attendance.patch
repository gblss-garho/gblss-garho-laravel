+                                    </div>
+                                @endforeach
+                            </div>
+                        @endif
+                    </article>
+                @empty
+                    <p class="cr-note">Koi student nahi mila.</p>
+                @endforelse
+            @endif
+        @endif
+    </div>
+@endsection
