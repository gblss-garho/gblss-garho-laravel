+
+    public function test_settings_page_saves_new_fields_and_off_days(): void
+    {
+        $this->actingAs($this->admin());
+        $this->get(route('admin.settings.edit', [], false))->assertOk()->assertSee('Head Master Name')->assertSee('Weekly Off Days');
+
+        $this->post(route('admin.settings.update', [], false), [
+            'name' => 'Test School', 'principal_name' => 'Head Sahib', 'principal_message' => 'Welcome',
+            'school_lat' => '24.30', 'school_lng' => '67.60', 'attendance_radius' => '150',
+            'off' => [0, 5],
+        ])->assertRedirect();
+
+        $row = \Illuminate\Support\Facades\DB::table('school_info')->where('id', 1)->first();
+        $this->assertSame('Head Sahib', $row->principal_name);
+        $this->assertSame('0,5', $row->weekly_off_days);
+
+        $this->get('/about')->assertOk()->assertSee('Head Master ka paigham')->assertSee('Head Sahib');
+    }
+
+    public function test_settings_requires_an_off_day(): void
+    {
+        $this->actingAs($this->admin());
+        $this->from('/admin/settings')->post(route('admin.settings.update', [], false), ['name' => 'X'])->assertSessionHasErrors('off');
+    }
 }
