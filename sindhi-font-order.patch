+<script>
+(function () {
+    // Wrap whole words containing ڄ (U+0684) so they are drawn in Noto Naskh Arabic, which has the right glyph.
+    function wrap(root) {
+        var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null), nodes = [], n;
+        while ((n = w.nextNode())) {
+            var p = n.parentNode && n.parentNode.nodeName;
+            if (n.nodeValue.indexOf('\u0684') > -1 && p !== 'SCRIPT' && p !== 'STYLE' && p !== 'TEXTAREA') { nodes.push(n); }
+        }
+        nodes.forEach(function (t) {
+            var frag = document.createDocumentFragment();
+            t.nodeValue.split(/(\s+)/).forEach(function (part) {
+                if (part.indexOf('\u0684') > -1) {
+                    var s = document.createElement('span'); s.className = 'sd-j'; s.textContent = part; frag.appendChild(s);
+                } else { frag.appendChild(document.createTextNode(part)); }
+            });
+            t.parentNode.replaceChild(frag, t);
+        });
+    }
+    document.addEventListener('DOMContentLoaded', function () { wrap(document.body); });
+})();
+</script>
 </body>
 </html>
