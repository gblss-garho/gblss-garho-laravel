             <script>
                 (function () {
                     var URL = @json($saveUrl), CSRF = @json(csrf_token()), CLASS = @json($class), DATE = @json($date), CIRC = {{ $circ }};
-                    var list = document.getElementById('daList'), msg = document.getElementById('daMsg');
