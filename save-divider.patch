                         [].forEach.call(list.querySelectorAll('.da-row'), function (row) {
-                            [].forEach.call(row.querySelectorAll('button'), function (b) {
-                                var on = marks[row.dataset.id] === b.dataset.s;
-                                b.className = on ? 'on k' + b.dataset.s : '';
-                            });
