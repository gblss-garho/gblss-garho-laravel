+        if ((int) $r->late_minutes > 0) {
+            return (int) $r->late_minutes;
+        }
+
+        // rows saved before the late_minutes column existed
+        return $r->check_in_at ? $this->schedule->lateMinutes($r->check_in_at->copy()) : 0;
+    }
