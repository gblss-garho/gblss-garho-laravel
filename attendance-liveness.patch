+/* ---------- Face scanner ---------- */
+.fs { max-width: 420px; margin: 14px auto; padding: 22px 18px 20px; border-radius: 26px; text-align: center; color: #FAF6EC;
+      background: radial-gradient(120% 90% at 50% 0%, #1B7A4D 0%, #0F5132 48%, #0a3a24 100%);
+      border: 1px solid rgba(219,180,60,.45); box-shadow: 0 18px 40px rgba(11,61,38,.28), inset 0 1px 0 rgba(255,255,255,.08); }
+.fs-title { font-family: 'Noto Serif', Georgia, serif; font-weight: 700; font-size: 18px; margin: 0 0 2px; }
+.fs-sub { font-size: 12.5px; opacity: .78; margin: 0 0 16px; }
+.fs-stage { --ring: rgba(219,180,60,.55); position: relative; width: min(74vw, 300px); aspect-ratio: 1; margin: 0 auto; }
+.fs-cam { position: absolute; inset: 7.5%; border-radius: 50%; overflow: hidden; background: #06261a;
+          box-shadow: inset 0 0 0 3px rgba(0,0,0,.35), 0 0 30px rgba(0,0,0,.35); }
+.fs-cam video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); display: block; }
+.fs-cam::after { content: ""; position: absolute; inset: 0; border-radius: 50%; box-shadow: inset 0 0 40px rgba(0,0,0,.45); pointer-events: none; }
+.fs-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
+.fs-ticks { fill: none; stroke: var(--ring); stroke-width: 3.2; stroke-dasharray: 1.1 1.9; transition: stroke .35s; }
+.fs-arc { fill: none; stroke: transparent; stroke-width: 3.2; stroke-linecap: round; stroke-dasharray: 62 230; transform-origin: 50% 50%; }
+.fs-check { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; font-size: 64px; color: #fff;
+            text-shadow: 0 4px 22px rgba(0,0,0,.55); }
+
+.fs[data-state=loading] .fs-stage { --ring: rgba(219,180,60,.35); }
+.fs[data-state=idle]    .fs-stage { --ring: rgba(219,180,60,.8); }
+.fs[data-state=idle]    .fs-ticks { animation: fsBreath 2.4s ease-in-out infinite; }
+.fs[data-state=scan]    .fs-stage { --ring: rgba(245,158,11,.30); }
+.fs[data-state=scan]    .fs-arc { stroke: #F59E0B; filter: drop-shadow(0 0 9px #F59E0B) drop-shadow(0 0 18px rgba(245,158,11,.8)); animation: fsSpin 1.15s linear infinite; }
+.fs[data-state=ok]      .fs-stage { --ring: #22C55E; }
+.fs[data-state=ok]      .fs-ticks { filter: drop-shadow(0 0 10px #22C55E) drop-shadow(0 0 20px rgba(34,197,94,.7)); }
+.fs[data-state=ok]      .fs-check { display: flex; background: rgba(21,128,61,.38); border-radius: 50%; inset: 7.5%; }
+.fs[data-state=fail]    .fs-stage { --ring: #EF4444; animation: fsShake .45s; }
+.fs[data-state=fail]    .fs-ticks { filter: drop-shadow(0 0 10px #EF4444) drop-shadow(0 0 20px rgba(239,68,68,.7)); }
+
+.fs-msg { min-height: 42px; margin: 16px 6px 12px; font-size: 14px; line-height: 1.45; font-weight: 500; }
+.fs[data-state=scan] .fs-msg { color: #FCD34D; }
+.fs[data-state=ok]   .fs-msg { color: #86EFAC; }
+.fs[data-state=fail] .fs-msg { color: #FCA5A5; }
+.fs-btn { font: inherit; font-weight: 700; font-size: 15px; padding: 12px 26px; border: 0; border-radius: 999px; cursor: pointer; margin: 0;
+          background: linear-gradient(135deg,#DBB43C,#C9A227); color: #1F2A24; box-shadow: 0 6px 16px rgba(0,0,0,.28); }
+.fs-btn:disabled { opacity: .55; cursor: default; }
+.fs-tips { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-top: 14px; }
+.fs-tips span { font-size: 11.5px; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.1); }
+@keyframes fsSpin { to { transform: rotate(360deg); } }
+@keyframes fsBreath { 0%,100% { opacity: .55; } 50% { opacity: 1; } }
+@keyframes fsShake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
+
+/* ---------- Today card + week ---------- */
+.at-today { max-width: 640px; margin: 10px 0 18px; padding: 16px 18px; border-radius: 18px; background: #fff; border: 1px solid #E3DCC7;
+            border-left: 5px solid var(--gold, #DBB43C); box-shadow: 0 4px 16px rgba(0,0,0,.06); }
+.at-today h2 { margin: 0 0 4px; font-size: 17px; }
+.at-today p { margin: 4px 0; color: #444; }
+.at-pill { display: inline-block; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
+.p-present { background: #DCFCE7; color: #14532D; } .p-late { background: #FEF3C7; color: #92400E; }
+.p-leave { background: #E0E7FF; color: #3730A3; }   .p-absent { background: #FEE2E2; color: #991B1B; }
+.p-off, .p-na, .p-upcoming { background: #ECECE6; color: #666; } .p-pending { background: #E0F2FE; color: #075985; }
+.at-err { background: #FEE2E2; color: #991B1B; border-radius: 12px; padding: 10px 14px; margin: 10px 0; max-width: 640px; }
+.at-ok { background: #DCFCE7; color: #14532D; border-radius: 12px; padding: 10px 14px; margin: 10px 0; max-width: 640px; }
+.wk-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; max-width: 640px; margin: 18px 0 10px; flex-wrap: wrap; }
+.wk-head h2 { margin: 0; font-size: 18px; }
+.wk-nav a { text-decoration: none; font-weight: 700; font-size: 13px; padding: 6px 12px; border-radius: 999px; background: #EAF3EF; color: #0F5132; margin-left: 4px; }
+.wk-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; max-width: 640px; margin-bottom: 12px; }
+.wk-stats div { background: #fff; border: 1px solid #E3DCC7; border-radius: 14px; padding: 10px 6px; text-align: center; }
+.wk-stats b { display: block; font-size: 22px; font-family: 'Noto Serif', Georgia, serif; }
+.wk-stats span { font-size: 11px; color: #666; }
+.wk-list { display: grid; gap: 8px; max-width: 640px; }
+.wk-day { display: grid; grid-template-columns: 54px 1fr auto; gap: 12px; align-items: center; background: #fff; border: 1px solid #E3DCC7; border-radius: 16px; padding: 10px 12px; }
+.wk-day.is-today { border-color: #C9A227; box-shadow: 0 0 0 2px rgba(219,180,60,.28); }
+.wk-date { text-align: center; border-radius: 12px; padding: 6px 0; background: #F3EFE2; line-height: 1.1; }
+.wk-date small { display: block; font-size: 10.5px; letter-spacing: .8px; color: #6b6b6b; text-transform: uppercase; }
+.wk-date b { font-family: 'Noto Serif', Georgia, serif; font-size: 20px; }
+.wk-times { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 12.5px; color: #333; }
+.wk-times em { font-style: normal; color: #888; }
+.wk-meta { font-size: 11.5px; color: #777; margin-top: 2px; }
+.wk-late { color: #B45309; font-weight: 700; }
+.wk-bar { position: relative; height: 5px; border-radius: 4px; background: #ECE7D6; margin-top: 7px; }
+.wk-bar i { position: absolute; top: 0; bottom: 0; border-radius: 4px; background: linear-gradient(90deg,#1B7A4D,#0F5132); }
+.wk-day.s-late .wk-bar i { background: linear-gradient(90deg,#F59E0B,#B45309); }
+.wk-day.s-off, .wk-day.s-na { opacity: .6; }
+@media (max-width: 420px) { .wk-day { grid-template-columns: 48px 1fr; } .wk-day > .at-pill { grid-column: 2; justify-self: start; } }
diff --git a/public/js/face-scan.js b/public/js/face-scan.js
new file mode 100644
index 0000000..2a7ca7b
--- /dev/null
+++ b/public/js/face-scan.js
@@ -0,0 +1,149 @@
+/* GBLSS face scanner: round camera frame with a status ring.
+   idle = soft gold, scan = amber light running round the ring, ok = green, fail = red. */
+(function () {
+    var MODELS = 'https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights';
+    var SCAN_MS = 7000;
+
+    function sleep(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
+
+    function init(root) {
+        var video = root.querySelector('video');
+        var msg = root.querySelector('.fs-msg');
+        var btn = root.querySelector('.fs-btn');
+        var form = root.querySelector('form');
+        var field = form.querySelector('input[name=descriptor_json]');
+        var idleLabel = btn.textContent;
+        var busy = false;
+
+        function state(s, text) {
+            root.setAttribute('data-state', s);
+            if (text) { msg.textContent = text; }
+        }
+
+        async function boot() {
+            state('loading', 'Camera aur face model load ho rahe hain...');
+            try {
+                if (!window.faceapi) { throw new Error('Face library load nahi hui. Internet check karen.'); }
+                await faceapi.nets.tinyFaceDetector.loadFromUri(MODELS);
+                await faceapi.nets.faceLandmark68Net.loadFromUri(MODELS);
+                await faceapi.nets.faceRecognitionNet.loadFromUri(MODELS);
+                var stream = await navigator.mediaDevices.getUserMedia({
+                    video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 640 } }, audio: false
+                });
+                video.srcObject = stream;
+                await video.play();
+                btn.disabled = false;
+                var first = root.getAttribute('data-initial-fail');
+                if (first) { state('fail', first); btn.textContent = 'Dobara Try Karen'; }
+                else { state('idle', 'Camera taiyar hai. Chehra gol frame ke beech mein rakhen.'); }
+            } catch (e) {
+                state('fail', 'Camera ya model shuru nahi hua: ' + (e && e.message ? e.message : e));
+            }
+        }
+
+        var challenges = (root.getAttribute('data-challenges') || '').split(',').filter(Boolean);
+        var liveField = form.querySelector('input[name=liveness]');
+        var FAST = function () { return new faceapi.TinyFaceDetectorOptions({ inputSize: 160, scoreThreshold: 0.5 }); };
+
+        function dist(a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }
+        function ear(eye) { // eye aspect ratio from the 6 eye landmarks
+            return (dist(eye[1], eye[5]) + dist(eye[2], eye[4])) / (2 * dist(eye[0], eye[3]));
+        }
+        function metrics(lm) {
+            var jaw = lm.getJawOutline(), nose = lm.getNose();
+            var w = jaw[16].x - jaw[0].x;
+            return {
+                ear: (ear(lm.getLeftEye()) + ear(lm.getRightEye())) / 2,
+                yaw: w > 0 ? (nose[3].x - jaw[0].x) / w : 0.5 // 0.5 = facing the camera
+            };
+        }
+        async function frame() {
+            var d = await faceapi.detectSingleFace(video, FAST()).withFaceLandmarks();
+            return d ? metrics(d.landmarks) : null;
+        }
+
+        var TEXT = {
+            blink: 'Ab ek dafa PALAK jhapkayen',
+            turn_left: 'Sir ko screen ke BAAYEN taraf ghumayen',
+            turn_right: 'Sir ko screen ke DAAYEN taraf ghumayen'
+        };
+
+        // Resolves true when the action is seen within `ms`.
+        async function doChallenge(name, ms) {
+            var t0 = Date.now(), open = 0, closedSeen = false;
+            while (Date.now() - t0 < ms) {
+                var m = await frame();
+                if (!m) { continue; }
+                if (name === 'blink') {
+                    if (m.ear > open) { open = m.ear; }
+                    if (open > 0.2 && m.ear < open * 0.74) { closedSeen = true; }
+                    else if (closedSeen && m.ear > open * 0.86) { return true; }
+                } else if (name === 'turn_left') { // nose moves toward the camera-left edge (raw image)
+                    if (m.yaw > 0.64) { return true; }
+                } else if (name === 'turn_right') {
+                    if (m.yaw < 0.36) { return true; }
+                }
+            }
+            return false;
+        }
+
+        async function waitFrontal(ms) {
+            var t0 = Date.now();
+            while (Date.now() - t0 < ms) {
+                var m = await frame();
+                if (m && m.yaw > 0.42 && m.yaw < 0.58) { return true; }
+            }
+            return false;
+        }
+
+        function fail(text) {
+            state('fail', text);
+            btn.textContent = 'Dobara Try Karen';
+            btn.disabled = false;
+            busy = false;
+        }
+
+        async function scan() {
+            if (busy) { return; }
+            busy = true;
+            btn.disabled = true;
+
+            state('scan', 'Chehra dhoondha ja raha hai... seedha dekhen.');
+            var first = null, t0 = Date.now();
+            while (Date.now() - t0 < 6000 && !first) {
+                first = await frame();
+                if (!first) { await sleep(150); }
+            }
+            if (!first) { return fail('Chehra nahi mila. Roshni mein, seedha camera ki taraf dekhen aur dobara try karen.'); }
+
+            for (var i = 0; i < challenges.length; i++) {
+                state('scan', 'Liveness ' + (i + 1) + '/' + challenges.length + ': ' + (TEXT[challenges[i]] || ''));
+                var ok = await doChallenge(challenges[i], 7000);
+                if (!ok) { return fail('Liveness check pass nahi hua (' + (TEXT[challenges[i]] || challenges[i]) + '). Dobara try karen.'); }
+                state('scan', 'Theek hai! Ab seedha camera mein dekhen...');
+                if (!(await waitFrontal(4000))) { return fail('Seedha dekhna zaroori hai. Dobara try karen.'); }
+            }
+
+            state('scan', 'Chehra pehchana ja raha hai... seedha dekhen.');
+            var found = await faceapi
+                .detectSingleFace(video, new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.5 }))
+                .withFaceLandmarks()
+                .withFaceDescriptor();
+            if (!found) { return fail('Chehra nahi mila. Dobara try karen.'); }
+
+            field.value = JSON.stringify(Array.prototype.slice.call(found.descriptor));
+            liveField.value = JSON.stringify({ c: challenges, ok: true });
+            state('ok', 'Asli insan ki tasdeeq ho gayi. Save ho raha hai...');
+            await sleep(900);
+            form.submit();
+        }
+
+        btn.addEventListener('click', scan);
+        boot();
+    }
+
+    document.addEventListener('DOMContentLoaded', function () {
+        var nodes = document.querySelectorAll('[data-face-scan]');
+        for (var i = 0; i < nodes.length; i++) { init(nodes[i]); }
+    });
+})();
