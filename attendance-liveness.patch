+
+        $joined = $teacher->created_at ? Carbon::parse($teacher->created_at)->startOfDay() : null;
+        $days = [];
+        $sum = ['present' => 0, 'late' => 0, 'leave' => 0, 'absent' => 0, 'late_minutes' => 0];
+
+        for ($i = 0; $i < 7; $i++) {
+            $d = $start->copy()->addDays($i);
+            $key = $d->toDateString();
+            $row = [
+                'date' => $d, 'status' => 'off', 'label' => 'Off', 'in' => null, 'out' => null,
